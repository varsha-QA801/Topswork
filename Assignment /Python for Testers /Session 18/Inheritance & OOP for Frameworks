Create a Python class called Song representing a Spotify song with attributes title, artist, and duration. Instantiate two Song objects and print their details.
Answer:

class Song:
    def __init__(self, title, artist, duration):
        self.title = title
        self.artist = artist
        self.duration = duration

    def display(self):
        print("Title:", self.title)
        print("Artist:", self.artist)
        print("Duration:", self.duration, "minutes")


song1 = Song("Perfect", "Ed Sheeran", 4)
song2 = Song("Shape of You", "Ed Sheeran", 3)

song1.display()
song2.display()


2.
Build a subclass called Podcast that inherits from the Song class, adds a new attribute host, and overrides the __str__ method to display all details including the host.
Answer:

class Song:
    def __init__(self, title, artist, duration):
        self.title = title
        self.artist = artist
        self.duration = duration

class Podcast(Song):
    def __init__(self, title, artist, duration, host):
        super().__init__(title, artist, duration)
        self.host = host

    def __str__(self):
        return f"Title: {self.title}, Artist: {self.artist}, Duration: {self.duration} minutes, Host: {self.host}"

p = Podcast("Tech Talk", "Spotify", 30, "Amit")

print(p)


